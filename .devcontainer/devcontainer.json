{
  "name": "UoPFuzz Sandbox",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  // SECURITY: Run as non-root user inside the container
  "remoteUser": "node",

  // SECURITY: capability/privilege containment — dropped caps, seccomp (via the
  // run args passed by the CLI), no-new-privileges, read-only rootfs (writable
  // tmpfs for /tmp and the npm cache), non-root user, memory/PID caps.
  //
  // NOTE: network is intentionally NOT disabled. The tool installs the fuzzer's
  // own dependencies (postCreateCommand) and each --target/benchmark package from
  // npm, and queries OSV.dev — all of which need egress. This matches
  // run-sandboxed.sh and the README "Security" section: the container provides
  // capability containment, not network isolation. Add an external egress policy
  // if you need to contain the network too.
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true",
    "--read-only",
    "--tmpfs=/tmp:rw,noexec,nosuid,size=512m",
    "--tmpfs=/home/node/.npm:rw,noexec,nosuid,size=256m",
    "--memory=2g",
    "--cpus=2",
    "--pids-limit=256"
  ],

  // Mount the project source as writable, everything else read-only
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "source=uopfuzz-node-modules,target=/workspace/node_modules,type=volume",
    "source=uopfuzz-results,target=/workspace/results,type=volume"
  ],

  "workspaceFolder": "/workspace",

  // Install dependencies on container creation
  "postCreateCommand": "npm install",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
