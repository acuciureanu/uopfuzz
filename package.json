{
  "name": "uopfuzz",
  "version": "0.1.0",
  "description": "A framework for finding prototype-pollution gadgets in JavaScript libraries via differential fuzzing with reproduction-gated reporting",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "uopfuzz": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:ci": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "lint": "eslint src/ tests/",
    "dev": "node --watch src/cli.js",
    "benchmark": "node benchmark/run-benchmark.js",
    "benchmark:self-test": "node benchmark/run-benchmark.js --self-test",
    "demo": "node scripts/gen-demo-cast.mjs && agg --font-size 22 --theme asciinema assets/demo.cast assets/demo.gif"
  },
  "keywords": [
    "security",
    "fuzzing",
    "prototype-pollution",
    "javascript",
    "differential-testing",
    "gadget-hunting"
  ],
  "author": "Alexandru Cuciureanu <alexandru.cuciureanu@gmail.com> (https://github.com/acuciureanu)",
  "license": "MIT",
  "dependencies": {
    "async": "^3.2.6",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "jsdom": "^22.1.0",
    "winston": "^3.11.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "qs": "^6.15.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acuciureanu/uopfuzz.git"
  }
}
