{
  "name": "uopfuzz",
  "version": "1.0.0",
  "description": "A plug-and-play framework for Undefined-Oriented Programming (UOP) in prototype pollution gadget hunting",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "uopfuzz": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "dev": "node --watch src/cli.js"
  },
  "keywords": [
    "security",
    "fuzzing",
    "prototype-pollution",
    "javascript",
    "concolic-execution",
    "gadget-hunting",
    "uop"
  ],
  "author": "UoPFuzz Team",
  "license": "MIT",
  "dependencies": {
    "async": "^3.2.6",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "jsdom": "^22.1.0",
    "winston": "^3.11.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "eslint": "^10.2.0",
    "qs": "^6.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acuciureanu/uopfuzz.git"
  }
}
