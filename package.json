{
  "name": "uopfuzz",
  "version": "1.0.0",
  "description": "A plug-and-play framework for Undefined-Oriented Programming (UOP) in prototype pollution gadget hunting",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "uopfuzz": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "scan": "node src/auto-scanner.js",
    "batch": "node src/batch-scanner.js",
    "scan-templates": "node src/batch-scanner.js targets/template-engines.txt --concurrency 4",
    "scan-merge": "node src/batch-scanner.js targets/object-merge.txt --concurrency 3",
    "scan-top100": "node src/batch-scanner.js targets/top-100.txt --concurrency 5",
    "test": "node --test tests/**/*.test.js",
    "lint": "eslint src/ tests/",
    "dev": "node --watch src/cli.js",
    "audit": "npm audit --audit-level=moderate",
    "check-deps": "npm outdated"
  },
  "keywords": [
    "security",
    "fuzzing",
    "prototype-pollution",
    "javascript",
    "concolic-execution",
    "gadget-hunting",
    "uop"
  ],
  "author": "UoPFuzz Team",
  "license": "MIT",
  "dependencies": {
    "yaml": "2.3.4",
    "commander": "11.1.0"
  },
  "devDependencies": {
    "eslint": "8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/acuciureanu/uopfuzz.git"
  }
}
